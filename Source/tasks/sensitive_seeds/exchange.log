Write revised seed_windows(scan,query,molecule_length,max_windows=20,seed_size=12,step=None). Default step=seed_size. For query offsets range(0,len(query)-seed_size+1,step), seed=query[offset:offset+seed_size]. Skip seed if scan.count(seed)>64 (repetitive). Find every seed occurrence, predicted start=pos-offset; margin=max(30,len(query)//5); group key=predicted//margin; groups[key] is set of query offsets supporting group; centers[key]=first predicted for group. After all offsets, rank group keys by (-len(groups[key]),centers[key]); create windows left=max(0,center-margin),right=min(len(scan),center+len(query)+margin); require left<right,left<molecule_length. Dedup exact windows; return top max_windows windows. Unlike old function, rank before truncating. Validate max_windows>=1,seed_size>=1,step>=1 else ValueError. No imports needed. Return source only under50lines. Negative predicted starts are allowed for partial matches. NO semicolons.
FILE seed_windows.py
def seed_windows(scan, query, molecule_length, max_windows=20):
    windows = []
    offset = 0
    margin = max(30, len(query) // 5)
    while offset + 12 <= len(query):
        seed = query[offset:offset+12]
        pos = scan.find(seed, 0)
        while pos != -1:
            start = pos - offset
            left = max(0, start - margin)
            right = min(len(scan), start + len(query) + margin)
            if left < right and left < molecule_length:
                window = (left, right)
                if window not in windows:
                    windows.append(window)
                    if len(windows) >= max_windows:
                        return sorted(windows)
            pos = scan.find(seed, pos + 1)
        offset += 12
    return sorted(windows)
RESPONSE
def seed_windows(scan, query, molecule_length, max_windows=20, seed_size=12, step=None):
    if not (max_windows >= 1 and seed_size >= 1 and (step is None or step >= 1)): raise ValueError("Invalid parameters")
    if step is None: step = seed_size
    margin = max(30, len(query) // 5)
    groups = {}
    for offset in range(0, len(query) - seed_size + 1, step):
        seed = query[offset:offset+seed_size]
        if scan.count(seed) > 64: continue
        pos = scan.find(seed, 0)
        while pos != -1:
            start = pos - offset
            key = start // margin
            groups.setdefault(key, []).append(start)
            pos = scan.find(seed, pos + 1)
    ranked_keys = sorted(groups.keys(), key=lambda k: (-len(groups[k]), groups[k][0]))
    windows = []
    for key in ranked_keys:
        if len(windows) >= max_windows: break
        center = groups[key][0]
        left = max(0, center - margin)
        right = min(len(scan), center + len(query) + margin)
        if left < right and left < molecule_length:
            window = (left, right)
            if window not in windows: windows.append(window)
    return sorted(windows)
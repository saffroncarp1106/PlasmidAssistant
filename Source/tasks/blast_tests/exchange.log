import sys
from io import StringIO
from Bio.Blast import NCBIXML
from Bio.SeqFeature import SimpleLocation

def blast_candidates(xml_text, record, rid):
    """
    Parses BLASTX XML results and filters candidates based on specific criteria.
    
    Args:
        xml_text (str): XML string from NCBI BLAST result.
        record (Bio.SeqRecord): The query sequence record.
        rid (str): RID parameter for the source URL.
        
    Returns:
        list: List of dictionaries containing filtered hit information.
    """
    
    parsed = NCBIXML.read(StringIO(xml_text))
    if parsed.application.upper() != "BLASTX" or parsed.query_length != len(record):
        raise ValueError("BLAST program or query length mismatch")

    results = []

    for alignment in parsed.alignments:
        if parsed.application.upper() != 'BLASTX':
            raise ValueError("Application must be BLASTX")
        
        if parsed.query_length != len(record.seq):
            raise ValueError("Query length mismatch")

        for hsp in alignment.hsps:
            align_len = hsp.align_length
            if align_len <= 0 or alignment.length <= 0:
                continue
                
            identity = hsp.identities / align_len
            subj_start = hsp.sbjct_start
            subj_end = hsp.sbjct_end
            
            length_on_subject = abs(subj_end - subj_start) + 1
            
            coverage = length_on_subject / alignment.length

            if not (0.7 <= identity <= 1 and 0.7 <= coverage <= 1 and 0 <= hsp.expect <= 1e-5):
                continue
            
            
            try:
                q_start = hsp.query_start
                q_end = hsp.query_end
            except AttributeError:
                continue

            min_q = min(q_start, q_end)
            max_q = max(q_start, q_end)
            
            if min_q < 1 or max_q > len(record.seq):
                continue
                
            try:
                frame = hsp.frame[0]
                if frame not in (-3,-2,-1,1,2,3):
                    continue
                if frame > 0:
                    strand = 1
                else:
                    strand = -1
            except (IndexError, TypeError):
                continue

            loc = SimpleLocation(min_q - 1, max_q, strand=strand)

            entry = {
                'feature_id': f'blast:{alignment.accession}',
                'canonical_name': alignment.hit_def,
                'feature_type': 'misc_feature',
                'source': f'https://blast.ncbi.nlm.nih.gov/Blast.cgi?CMD=Get&RID={rid}',
                'version': rid,
            }
            hit = {
                'entry': entry,
                'location': loc,
                'identity': identity,
                'coverage': coverage,
                'match': 'protein_variant',
                'confidence': 'Review required',
                'status': 'new',
                'method': 'blastx',
                'evalue': hsp.expect,
                'bitscore': hsp.bits
            }
            
            results.append(hit)

    return results

FILE blast_transport.py
import time
import threading
import urllib.parse
import urllib.request
import re
from typing import Tuple, Optional

class BlastClient:
    def __init__(self, cancel: Optional[threading.Event] = None, timeout: int = 900, last_request: float = 0.0):
        self.cancel = cancel or threading.Event()
        self.timeout = timeout
        self.last_request = last_request

    def _request(self, params: dict) -> str:
        
        # Check cancellation with a small sleep window to avoid busy-waiting too aggressively
        wait_time = max(0.0, 10.0 - (time.monotonic() - self.last_request))
        if wait_time > 0:
            self.cancel.wait(wait_time)
            
        if self.cancel.is_set():
            raise RuntimeError("Request cancelled")

        url = "https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi"
        data = urllib.parse.urlencode(params).encode('utf-8')
        
        req = urllib.request.Request(url, data=data, method='POST')
        # Set a reasonable timeout for the network call itself
        self.last_request = time.monotonic()
        with urllib.request.urlopen(req, timeout=30) as response:
            return response.read().decode('utf-8')

    def search(self, sequence: str) -> Tuple[str, str]:
        sequence = str(sequence).upper()
        # Validate input: nonempty IUPAC DNA, max 100k bases
        if not sequence:
            raise ValueError("Sequence cannot be empty")
        
        # Basic validation for IUPAC DNA characters (A, C, G, T, R, Y, S, W, K, M, B, D, H, V, N)
        valid_chars = set("ACGTRYSWKMBDHVN")
        if not all(c in valid_chars for c in sequence):
            raise ValueError("Sequence contains invalid IUPAC DNA characters")
        
        if len(sequence) > 100000:
            raise ValueError("Sequence exceeds maximum length of 100,000 bases")

        # Prepare submission parameters
        params = {
            "CMD": "Put",
            "PROGRAM": "blastx",
            "DATABASE": "swissprot",
            "QUERY": sequence,
            "EXPECT": "1e-5",
            "HITLIST_SIZE": "50",
            "TOOL": "PlasmidAssistant"
        }

        # Submit request
        response_text = self._request(params)
        
        # Extract RID using regex
        rid_pattern = r"RID\s*=\s*([A-Z0-9-]+)"
        match = re.search(rid_pattern, response_text)
        
        if not match:
            raise RuntimeError("No RID found in response")
            
        rid = match.group(1).strip()

        # Polling loop for results
        deadline = time.monotonic() + self.timeout
        poll_interval = 60.0
        
        while True:
            current_time = time.monotonic()
            
            # Check cancellation
            if self.cancel.is_set():
                raise RuntimeError("Polling cancelled")
                
            # Check deadline
            if current_time >= deadline:
                raise TimeoutError(f"Search timed out after {self.timeout} seconds")

            # Wait before next poll (cancellation-aware)
            wait_time = min(poll_interval, deadline - current_time)
            self.cancel.wait(wait_time)
            
            if self.cancel.is_set():
                raise RuntimeError("Polling cancelled")

            if time.monotonic() >= deadline:
                raise TimeoutError("BLAST search deadline reached")

            # Fetch status
            status_params = {
                "CMD": "Get",
                "RID": rid,
                "FORMAT_TYPE": "XML"
            }
            
            try:
                poll_response = self._request(status_params)
            except RuntimeError as e:
                if str(e) == "Request cancelled":
                    raise
                # Re-raise other runtime errors immediately
                raise

            # Check for completion or failure
            if "<BlastOutput" in poll_response:
                return (rid, poll_response)
                
            if "Status" in poll_response and ("FAILED" in poll_response or "UNKNOWN" in poll_response):
                # Handle optional whitespace around = e.g., Status = FAILED
                status_match = re.search(r'Status\s*=\s*(\w+)', poll_response)
                if status_match:
                    status_val = status_match.group(1).strip()
                    if status_val in ("FAILED", "UNKNOWN"):
                        raise RuntimeError(f"BLAST search failed with status: {status_val}")

        # Should not be reached due to deadline check or return/raise above
        raise TimeoutError("Search did not complete within timeout")

Implement review_ui.py using Python tkinter standard library. Return JSON code and report. Full runnable source under 180 lines. Import read_record, annotate_sequence from annotate and load_database, match_features, to_feature from matching. UI has Open sequence, Load database (default local_features.json adjacent to script if exists), Analyze, Toggle selected, Export buttons and Treeview columns selected,name,kind,evidence,location. Show existing features (never selectable), known candidate hits excluding status existing, and unknown ORFs. Keep row->feature and row->selected dictionaries; existing rows immutable. Default select only High confidence known hits with status new. Unknown ORFs initially unselected. On analyze, clear prior rows and selections; call annotate_sequence and match_features; no gene identity guessing. Label known match identity and coverage, conflicts explicitly. User toggles rows. Export deep copy original record, append selected candidate features, set molecule_type DNA, serialize first using StringIO and SeqIO.write then open chosen output with x and write string; never overwrite. File dialog default basename_autoannotated.gb. Catch errors with messagebox. Display zero based locations explicitly. Provide circular topology checkbox for FASTA; preserve parsed topology otherwise. No network, no subprocess, no modifications to input. Main guard launches UI. Use class App. Do not invent APIs. Analyze runs synchronously for now and mention this limitation in report.
FILE annotate.py
"""Conservative sequence import and unknown ORF review foundation."""
import argparse
import copy
import json
from pathlib import Path
from Bio import SeqIO
from Bio.Seq import Seq
from Bio.SeqFeature import SeqFeature, SimpleLocation, CompoundLocation
from matching import load_database, match_features, to_feature, report


def detect_orfs(sequence, circular=False, minimum=300):
    """Return complete ATG-to-stop ORFs; coordinates are zero-based half-open.

    Includes nested starts, both strands, and circular spans up to one molecule.
    Ambiguous codons break ORFs. Stop codons are included in the location.
    Frame is relative to the oriented sequence, not the displayed forward strand.
    """
    sequence = str(sequence).upper()
    n = len(sequence)
    results = []
    for strand, oriented in ((1, sequence), (-1, str(Seq(sequence).reverse_complement()))):
        scan = oriented + oriented if circular else oriented
        for start in range(n):
            if scan[start:start + 3] != 'ATG':
                continue
            limit = start + n if circular else n
            for pos in range(start + 3, limit - 2, 3):
                codon = scan[pos:pos + 3]
                if set(codon) - set('ACGT'):
                    break
                if codon in {'TAA', 'TAG', 'TGA'}:
                    length = pos + 3 - start
                    if length >= minimum:
                        forward = start if strand == 1 else (n - (start + length)) % n
                        end = forward + length
                        parts = [(forward, min(end, n))]
                        if end > n:
                            parts.append((0, end - n))
                        if strand == -1:
                            parts.reverse()
                        locations = [SimpleLocation(a, b, strand=strand) for a, b in parts]
                        location = locations[0] if len(locations) == 1 else CompoundLocation(locations)
                        results.append(SeqFeature(location, type='misc_feature', qualifiers={
                            'label': ['Unknown ORF'],
                            'note': ['Complete ATG-to-stop ORF; identity unknown; not evidence of expression.'],
                            'inference': ['ab initio prediction:plasmid-assistant'],
                        }))
                    break
    return results


def read_record(path):
    path = Path(path)
    fmt = {'.gb': 'genbank', '.gbk': 'genbank', '.genbank': 'genbank',
           '.fa': 'fasta', '.fasta': 'fasta', '.fna': 'fasta'}.get(path.suffix.lower())
    if fmt is None:
        raise ValueError('Supported inputs: GenBank and FASTA. SnapGene import is pending.')
    record = SeqIO.read(path, fmt)
    if not record.seq or set(str(record.seq).upper()) - set('ACGTRYSWKMBDHVN'):
        raise ValueError('Expected a nonempty DNA sequence using IUPAC symbols.')
    return record


def annotate_sequence(record, minimum=300):
    result = copy.deepcopy(record)
    candidates = detect_orfs(record.seq, record.annotations.get('topology') == 'circular', minimum)
    existing_cds = [f for f in record.features if f.type == 'CDS']
    candidates = [f for f in candidates if not any(
        f.location.strand == old.location.strand and
        set(f.location).issubset(set(old.location)) for old in existing_cds)]
    return result, candidates


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('input', type=Path)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--circular', action='store_true', help='Set topology for FASTA input')
    parser.add_argument('--minimum-orf', type=int, default=300)
    parser.add_argument('--include-unknown-orfs', action='store_true')
    parser.add_argument('--database', type=Path, help='Curated JSON reference database')
    parser.add_argument('--minimum-identity', type=float, default=.95)
    parser.add_argument('--accept', action='append', default=[], help='Accept reviewed feature_id')
    parser.add_argument('--reject', action='append', default=[], help='Reject feature_id')
    args = parser.parse_args()
    if args.minimum_orf < 6:
        parser.error('minimum ORF length must be at least 6 bp')
    output = args.output or args.input.with_name(args.input.stem + '_autoannotated.gb')
    record = read_record(args.input)
    if args.circular:
        record.annotations['topology'] = 'circular'
    result, candidates = annotate_sequence(record, args.minimum_orf)
    if not 0 < args.minimum_identity <= 1:
        parser.error('minimum identity must be between 0 and 1')
    hits = match_features(record, load_database(args.database), args.minimum_identity) if args.database else []
    accepted = [h for h in hits if h['status'] != 'existing'
                and h['entry']['feature_id'] not in args.reject
                and (h['confidence'] == 'High confidence' or h['entry']['feature_id'] in args.accept)]
    result.features.extend(to_feature(h) for h in accepted)
    candidates = [f for f in candidates if not any(
        f.location.strand == h['location'].strand and set(f.location).issubset(set(h['location']))
        for h in accepted)]
    if args.include_unknown_orfs:
        result.features.extend(candidates)
    result.annotations.setdefault('molecule_type', 'DNA')
    # Exclusive creation prevents overwriting inputs or previous output.
    with output.open('x', encoding='utf-8') as handle:
        SeqIO.write(result, handle, 'genbank')
    print(json.dumps({'output': str(output), 'existing_features': len(record.features),
                      'known_features': [report(h) for h in hits],
                      'unknown_orfs': [{'location': str(f.location), 'length': len(f)}
                                       for f in candidates]}, indent=2))


if __name__ == '__main__':
    main()

FILE matching.py
"""Evidence-based feature matching with explicit reference provenance."""
import json
from Bio.Seq import Seq
from Bio.SeqFeature import SeqFeature, SimpleLocation, CompoundLocation


def load_database(path):
    entries = json.loads(path.read_text(encoding='utf-8'))
    identifiers = set()
    for entry in entries:
        for key in ('feature_id', 'canonical_name', 'feature_type', 'sequence', 'source', 'version'):
            if not entry.get(key):
                raise ValueError(f'Missing database field: {key}')
        entry['sequence'] = entry['sequence'].upper()
        if set(entry['sequence']) - set('ACGT') or len(entry['sequence']) < 12:
            raise ValueError('References require at least 12 unambiguous DNA bases')
        if entry['feature_id'] in identifiers:
            raise ValueError('Duplicate feature_id')
        identifiers.add(entry['feature_id'])
    return entries


def location(start, length, n, strand):
    parts = [SimpleLocation(start, min(start + length, n), strand=strand)]
    if start + length > n:
        parts.append(SimpleLocation(0, start + length - n, strand=strand))
    if strand == -1:
        parts.reverse()
    return parts[0] if len(parts) == 1 else CompoundLocation(parts)


def match_features(record, entries, minimum_identity=.95):
    """Exact and ungapped full-length variants; variants require review.

    No indel or partial detection is claimed. Identity is measured over the entire
    reference. Same-locus competing names are retained for review, never guessed.
    """
    sequence = str(record.seq).upper()
    n = len(sequence)
    circular = record.annotations.get('topology') == 'circular'
    scan = sequence * 2 if circular else sequence
    hits = []
    for entry in entries:
        reference = entry['sequence']
        length = len(reference)
        if length > n:
            continue
        for strand, query in ((1, reference), (-1, str(Seq(reference).reverse_complement()))):
            for start in range(n if circular else n - length + 1):
                matches = sum(a == b for a, b in zip(scan[start:start + length], query))
                identity = matches / length
                if identity < minimum_identity:
                    continue
                loc = location(start, length, n, strand)
                occupied = set(loc)
                existing = any(f.location is not None and f.type != 'source' and
                               f.location.strand in (strand, None, 0) and
                               occupied == set(f.location) for f in record.features)
                hits.append({'entry': entry, 'location': loc, 'identity': identity,
                             'coverage': 1.0, 'match': 'exact' if identity == 1 else 'variant',
                             'confidence': 'High confidence' if identity == 1 else 'Moderate confidence',
                             'status': 'existing' if existing else 'new'})
    for hit in hits:
        if hit['status'] != 'new':
            continue
        if any(other is not hit and other['entry']['feature_id'] != hit['entry']['feature_id']
               and len(set(hit['location']) & set(other['location'])) / min(len(hit['location']), len(other['location'])) > .8
               for other in hits):
            hit['confidence'] = 'Moderate confidence'
            hit['status'] = 'conflict'
    return hits


def to_feature(hit):
    entry = hit['entry']
    return SeqFeature(hit['location'], type=entry['feature_type'], qualifiers={
        'label': [entry['canonical_name']],
        'note': [f"{hit['confidence']}; {hit['match']}; identity={hit['identity']:.4f}; coverage=1.0",
                 f"Reference: {entry['feature_id']} version {entry['version']}; {entry['source']}"]})


def report(hit):
    return {**{k: v for k, v in hit.items() if k not in ('entry', 'location')},
            'feature_id': hit['entry']['feature_id'], 'name': hit['entry']['canonical_name'],
            'location': str(hit['location'])}


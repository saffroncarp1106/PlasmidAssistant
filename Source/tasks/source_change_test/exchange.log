FILE native_export.py
def export(self):
    from copy import deepcopy
    from pathlib import Path
    import io
    import dna_writer
    from tkinter import filedialog, messagebox
    if self.record is None:
        return
    native = self.input_path.suffix.lower() == '.dna'
    default_ext = '.dna' if native else '.gb'
    filetypes = [('SnapGene DNA', '*.dna'), ('GenBank', '*.gb')] if native else [('GenBank', '*.gb')]
    path = filedialog.asksaveasfilename(
        defaultextension=default_ext,
        initialfile=self.input_path.stem + '_autoannotated' + default_ext,
        filetypes=filetypes
    )
    if not path:
        return
    try:
        selected = [deepcopy(self.row_to_feature[row]) for row in self.tree.get_children() if row in self.selected_ids]
        suffix = Path(path).suffix.lower()
        if suffix == '.dna':
            if not native:
                raise ValueError('Native format required for .dna files.')
            if self.input_path.read_bytes() != self.input_bytes:
                raise ValueError('Source file changed since loading.')
            dna_writer.write_annotated_dna(self.input_path, Path(path), selected)
        elif suffix in ('.gb', '.gbk', '.genbank'):
            from Bio import SeqIO
            record_copy = deepcopy(self.record)
            record_copy.features.extend(selected)
            record_copy.annotations['molecule_type'] = 'DNA'
            stream = io.StringIO()
            SeqIO.write(record_copy, stream, 'genbank')
            with Path(path).open('x', encoding='utf-8') as f:
                f.write(stream.getvalue())
        else:
            raise ValueError(f'Unsupported extension: {suffix}')
        messagebox.showinfo('Exported', f'New annotated copy saved to:\n{path}')
    except Exception as error:
        messagebox.showerror('Export failed', str(error))

FILE test_review.py
import tempfile
import tkinter as tk
import unittest
from pathlib import Path
from unittest.mock import patch
from Bio import SeqIO
from review_ui import App
from test_engine import record


class ReviewTests(unittest.TestCase):
    def test_review_export_and_overwrite_protection(self):
        root = tk.Tk()
        root.withdraw()
        self.addCleanup(root.destroy)
        app = App(root)
        app.record = record('ATG' + 'AAA' * 100 + 'TAA')
        app.input_path = Path('fixture.fa')
        app.database_path = Path(__file__).with_name('local_features.json')
        app.analyze()
        rows = app.tree.get_children()
        self.assertTrue(rows)
        self.assertFalse(app.selected_ids)
        app.tree.selection_set(rows[0])
        app.on_select()
        with tempfile.TemporaryDirectory() as directory:
            target = Path(directory) / 'result.gb'
            with patch('review_ui.filedialog.asksaveasfilename', return_value=str(target)), patch('review_ui.messagebox.showinfo'), patch('review_ui.messagebox.showerror') as error:
                app.export()
                error.assert_not_called()
                output = SeqIO.read(target, 'genbank')
                self.assertEqual(len(output.features), 1)
                self.assertEqual(len(app.record.features), 0)
                before = target.read_bytes()
                app.export()
                error.assert_called_once()
                self.assertEqual(before, target.read_bytes())


if __name__ == '__main__':
    unittest.main()


{
  "code": "import json, hashlib, copy, io\nfrom pathlib import Path\nfrom Bio import SeqIO\n\nroot = Path(__file__).resolve().parent\nwith open(root / 'local_features.json') as f:\n    data = json.load(f)\nsrc_path = Path(data[0]['source'])\nbytes_data = src_path.read_bytes()\nsha256_before = hashlib.sha256(bytes_data).hexdigest()\nrecord = SeqIO.read(src_path, 'snapgene')\ndeep_record = copy.deepcopy(record)\ndeep_record.annotations['molecule_type'] = 'DNA'\nstream = io.StringIO()\nSeqIO.write(deep_record, stream, 'genbank')\nstream.seek(0)\nread_back = SeqIO.read(stream, 'genbank')\nassert str(read_back.seq) == str(record.seq)\nassert read_back.topology == record.topology\nassert len(read_back.features) == len(record.features)\nfor f1, f2 in zip(read_back.features, record.features):\n    assert f1.location == f2.location\n    assert f1.type == f2.type\n    assert f1.qualifiers == f2.qualifiers\nassert sha256_before == hashlib.sha256(src_path.read_bytes()).hexdigest()\nresult = {\n    'source_path': str(src_path),\n    'sequence_length': len(record.seq),\n    'feature_count': len(record.features),\n    'roundtrip_passed': True\n}\nprint(json.dumps(result))",
  "report": "Script check_real.py generated successfully. It loads local_features.json, validates the first entry's source file via SHA256, parses with SnapGene format, deepcopies, sets molecule type to DNA, writes to StringIO in GenBank format, reads back, and asserts sequence, topology, feature count, location, type, and qualifiers match. Input SHA256 is verified unchanged. No files are written or modified except reading the input JSON and source file."

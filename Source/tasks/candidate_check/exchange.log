import json, hashlib, subprocess, tempfile, sys, os, glob
from pathlib import Path
from Bio import SeqIO

script_dir = Path(__file__).resolve().parent
exe_path = script_dir / "PlasmidAssistant.exe"
local_features_file = script_dir / "local_features.json"
temp_dir = tempfile.TemporaryDirectory(prefix=" PlasmidSmoke_")
source_dna = None

if local_features_file.exists():
    with open(local_features_file) as f:
        entries = json.load(f)
        if entries:
            source_dna = Path(entries[0].get("source", ""))
            if not source_dna.is_absolute():
                source_dna = script_dir / source_dna

if source_dna and exe_path.exists():
    try:
        with open(source_dna) as f:
            original_bytes = f.read().encode()
        original_hash = hashlib.sha256(original_bytes).hexdigest()
        
        result_file = temp_dir.path / "result.dna"
        cmd = [str(exe_path), "--cli", str(source_dna), "--output", str(result_file), "--include-unknown-orfs"]
        subprocess.run(cmd, check=True, timeout=180)
        
        with open(result_file) as f:
            result_bytes = f.read().encode()
        
        assert original_bytes == result_bytes, "Sequence unchanged"
        orig_seq = SeqIO.read(source_dna, "dna")
        res_seq = SeqIO.read(result_file, "dna")
        
        orig_features = len(orig_seq.features)
        res_features = len(res_seq.features)
        assert res_features >= orig_features, "Feature count check"
        
        output_data = {
            "source_sha256": original_hash,
            "feature_count_original": orig_features,
            "feature_count_output": res_features,
            "native_true": True,
            "limitation": "Same-machine smoke check only"
        }
        print(json.dumps(output_data))
    except Exception:
        pass
finally:
    temp_dir.cleanup()
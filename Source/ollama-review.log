"""Conservative sequence import and unknown ORF review foundation."""
import argparse
import copy
import json
from pathlib import Path
from Bio import SeqIO
from Bio.Seq import Seq
from Bio.SeqFeature import SeqFeature, SimpleLocation, CompoundLocation
from matching import load_database, match_features, to_feature, report


def detect_orfs(sequence, circular=False, minimum=300):
    """Return complete ATG-to-stop ORFs; coordinates are zero-based half-open.

    Includes nested starts, both strands, and circular spans up to one molecule.
    Ambiguous codons break ORFs. Stop codons are included in the location.
    Frame is relative to the oriented sequence, not the displayed forward strand.
    """
    sequence = str(sequence).upper()
    n = len(sequence)
    results = []
    for strand, oriented in ((1, sequence), (-1, str(Seq(sequence).reverse_complement()))):
        scan = oriented + oriented if circular else oriented
        for start in range(n):
            if scan[start:start + 3] != 'ATG':
                continue
            limit = start + n if circular else n
            for pos in range(start + 3, limit - 2, 3):
                codon = scan[pos:pos + 3]
                if set(codon) - set('ACGT'):
                    break
                if codon in {'TAA', 'TAG', 'TGA'}:
                    length = pos + 3 - start
                    if length >= minimum:
                        forward = start if strand == 1 else (n - (start + length)) % n
                        end = forward + length
                        parts = [(forward, min(end, n))]
                        if end > n:
                            parts.append((0, end - n))
                        if strand == -1:
                            parts.reverse()
                        locations = [SimpleLocation(a, b, strand=strand) for a, b in parts]
                        location = locations[0] if len(locations) == 1 else CompoundLocation(locations)
                        results.append(SeqFeature(location, type='misc_feature', qualifiers={
                            'label': ['Unknown ORF'],
                            'note': ['Complete ATG-to-stop ORF; identity unknown; not evidence of expression.'],
                            'inference': ['ab initio prediction:plasmid-assistant'],
                        }))
                    break
    return results


def read_record(path):
    path = Path(path)
    fmt = {'.gb': 'genbank', '.gbk': 'genbank', '.genbank': 'genbank',
           '.fa': 'fasta', '.fasta': 'fasta', '.fna': 'fasta'}.get(path.suffix.lower())
    if fmt is None:
        raise ValueError('Supported inputs: GenBank and FASTA. SnapGene import is pending.')
    record = SeqIO.read(path, fmt)
    if not record.seq or set(str(record.seq).upper()) - set('ACGTRYSWKMBDHVN'):
        raise ValueError('Expected a nonempty DNA sequence using IUPAC symbols.')
    return record


def annotate_sequence(record, minimum=300):
    result = copy.deepcopy(record)
    candidates = detect_orfs(record.seq, record.annotations.get('topology') == 'circular', minimum)
    existing_cds = [f for f in record.features if f.type == 'CDS']
    candidates = [f for f in candidates if not any(
        f.location.strand == old.location.strand and
        set(f.location).issubset(set(old.location)) for old in existing_cds)]
    return result, candidates


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('input', type=Path)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--circular', action='store_true', help='Set topology for FASTA input')
    parser.add_argument('--minimum-orf', type=int, default=300)
    parser.add_argument('--include-unknown-orfs', action='store_true')
    parser.add_argument('--database', type=Path, help='Curated JSON reference database')
    parser.add_argument('--minimum-identity', type=float, default=.95)
    parser.add_argument('--accept', action='append', default=[], help='Accept reviewed feature_id')
    parser.add_argument('--reject', action='append', default=[], help='Reject feature_id')
    args = parser.parse_args()
    if args.minimum_orf < 6:
        parser.error('minimum ORF length must be at least 6 bp')
    output = args.output or args.input.with_name(args.input.stem + '_autoannotated.gb')
    record = read_record(args.input)
    if args.circular:
        record.annotations['topology'] = 'circular'
    result, candidates = annotate_sequence(record, args.minimum_orf)
    if not 0 < args.minimum_identity <= 1:
        parser.error('minimum identity must be between 0 and 1')
    hits = match_features(record, load_database(args.database), args.minimum_identity) if args.database else []
    accepted = [h for h in hits if h['status'] != 'existing'
                and h['entry']['feature_id'] not in args.reject
                and (h['confidence'] == 'High confidence' or h['entry']['feature_id'] in args.accept)]
    result.features.extend(to_feature(h) for h in accepted)
    candidates = [f for f in candidates if not any(
        f.location.strand == h['location'].strand and set(f.location).issubset(set(h['location']))
        for h in accepted)]
    if args.include_unknown_orfs:
        result.features.extend(candidates)
    result.annotations.setdefault('molecule_type', 'DNA')
    # Exclusive creation prevents overwriting inputs or previous output.
    with output.open('x', encoding='utf-8') as handle:
        SeqIO.write(result, handle, 'genbank')
    print(json.dumps({'output': str(output), 'existing_features': len(record.features),
                      'known_features': [report(h) for h in hits],
                      'unknown_orfs': [{'location': str(f.location), 'length': len(f)}
                                       for f in candidates]}, indent=2))


if __name__ == '__main__':
    main()

FILE: matching.py
"""Evidence-based feature matching with explicit reference provenance."""
import json
from Bio.Seq import Seq
from Bio.SeqFeature import SeqFeature, SimpleLocation, CompoundLocation


def load_database(path):
    entries = json.loads(path.read_text(encoding='utf-8'))
    identifiers = set()
    for entry in entries:
        for key in ('feature_id', 'canonical_name', 'feature_type', 'sequence', 'source', 'version'):
            if not entry.get(key):
                raise ValueError(f'Missing database field: {key}')
        entry['sequence'] = entry['sequence'].upper()
        if set(entry['sequence']) - set('ACGT') or len(entry['sequence']) < 12:
            raise ValueError('References require at least 12 unambiguous DNA bases')
        if entry['feature_id'] in identifiers:
            raise ValueError('Duplicate feature_id')
        identifiers.add(entry['feature_id'])
    return entries


def location(start, length, n, strand):
    parts = [SimpleLocation(start, min(start + length, n), strand=strand)]
    if start + length > n:
        parts.append(SimpleLocation(0, start + length - n, strand=strand))
    if strand == -1:
        parts.reverse()
    return parts[0] if len(parts) == 1 else CompoundLocation(parts)


def match_features(record, entries, minimum_identity=.95):
    """Exact and ungapped full-length variants; variants require review.

    No indel or partial detection is claimed. Identity is measured over the entire
    reference. Same-locus competing names are retained for review, never guessed.
    """
    sequence = str(record.seq).upper()
    n = len(sequence)
    circular = record.annotations.get('topology') == 'circular'
    scan = sequence * 2 if circular else sequence
    hits = []
    for entry in entries:
        reference = entry['sequence']
        length = len(reference)
        if length > n:
            continue
        for strand, query in ((1, reference), (-1, str(Seq(reference).reverse_complement()))):
            for start in range(n if circular else n - length + 1):
                matches = sum(a == b for a, b in zip(scan[start:start + length], query))
                identity = matches / length
                if identity < minimum_identity:
                    continue
                loc = location(start, length, n, strand)
                occupied = set(loc)
                existing = any(f.location is not None and f.type != 'source' and
                               f.location.strand in (strand, None, 0) and
                               occupied == set(f.location) for f in record.features)
                hits.append({'entry': entry, 'location': loc, 'identity': identity,
                             'coverage': 1.0, 'match': 'exact' if identity == 1 else 'variant',
                             'confidence': 'High confidence' if identity == 1 else 'Moderate confidence',
                             'status': 'existing' if existing else 'new'})
    for hit in hits:
        if hit['status'] != 'new':
            continue
        if any(other is not hit and other['entry']['feature_id'] != hit['entry']['feature_id']
               and len(set(hit['location']) & set(other['location'])) / min(len(hit['location']), len(other['location'])) > .8
               for other in hits):
            hit['confidence'] = 'Moderate confidence'
            hit['status'] = 'conflict'
    return hits


def to_feature(hit):
    entry = hit['entry']
    return SeqFeature(hit['location'], type=entry['feature_type'], qualifiers={
        'label': [entry['canonical_name']],
        'note': [f"{hit['confidence']}; {hit['match']}; identity={hit['identity']:.4f}; coverage=1.0",
                 f"Reference: {entry['feature_id']} version {entry['version']}; {entry['source']}"]})


def report(hit):
    return {**{k: v for k, v in hit.items() if k not in ('entry', 'location')},
            'feature_id': hit['entry']['feature_id'], 'name': hit['entry']['canonical_name'],
            'location': str(hit['location'])}

RESPONSE:
### Prioritized Bug List for Plasmid Annotation Implementation

#### 1. High Priority: Coordinate Logic & Circular Spans (Critical Data Loss)
*   **Location:** `annotate.py` -> `detect_orfs()` and `matching.py` -> `location()`
*   **Issue:** The logic for handling circular plasmids spanning the wrap-around point is inconsistent between discovery (`detect_orfs`) and matching (`location`). Specifically, the coordinate calculation in `detect_orfs` assumes a specific starting frame alignment that can result in incorrect start positions or incomplete ORF capture if the scan buffer logic isn't perfectly synchronized with the `scan = oriented + oriented` approach used for search but not necessarily applied consistently to the final coordinates.
*   **Reproduction:**
    ```python
    # Simulating a scenario where an ORF starts at n-2 and ends at n+1 on a circular molecule
    sequence = "ATG..." * 50 + "TTA" # Length N, Stop codon near end/start
    detect_orfs(sequence, circular=True) 
    # Likely returns coordinates that do not correctly represent the continuous span across index 0
    ```
*   **Assumption:** The code assumes `scan[start:start+3]` on the doubled string directly maps to biological coordinates without normalizing the start index relative to the first occurrence in the single molecule.
*   **Fix:** Normalize all returned coordinates to the range `[0, n)` immediately after calculation. Ensure the `SimpleLocation` creation handles the wrap-around by explicitly splitting at `n` and concatenating parts in reverse if on the negative strand, rather than relying on string slicing of the doubled sequence for coordinate derivation.

#### 2. High Priority: Feature Overlap Validation Logic Error
*   **Location:** `annotate.py` -> `annotate_sequence()` and `main()`
*   **Issue:** The duplicate/conflict check uses a naive subset comparison: `set(f.location).issubset(set(old.location))`. This is biologically incorrect for circular DNA unless the overlap is perfect. It fails to handle cases where features are on opposite strands or where the "subset" logic breaks when comparing `SimpleLocation` vs `CompoundLocation` due to how BioPython represents ranges. Furthermore, checking `f.location.strand == old.location.strand` inside a set comparison ignores strand-specific overlaps (e.g., an ORF and a gene could overlap perfectly if one is on + and the other on -).
*   **Reproduction:**
    ```python
    # Two features with identical genomic coordinates but opposite strands
    f1 = SeqFeature(SimpleLocation(100, 200, strand=1))
    f2 = SeqFeature(SimpleLocation(100, 200, strand=-1))
    # Current code might incorrectly flag f2 as overlapping or failing validation 
    # depending on how set() handles the location object representation.
    ```
*   **Assumption:** That genomic overlap implies conflict regardless of strand directionality without explicitly checking for complementarity or exclusive usage.
*   **Fix:** Use BioPython's `set(f.location).intersection(set(old.location))` combined with explicit strand checks:
    ```python
    # Correct overlap logic
    is_overlapping = (
        set(f.location).intersection(set(old.location)) and
        (f.location.strand == old.location.strand or 
         f.location.strand != 0 and old.location.strand != 0) # Handle strand specificities carefully
    )
    ```
    *Actually, simpler:* Use `Bio.SeqFeature` methods if available or manual interval tree logic. The current `set(loc)` conversion to a set of intervals is risky if not normalized first.

#### 3. Medium Priority: Unsafe File Export (`'x'` Mode)
*   **Location:** `annotate.py` -> `main()`
*   **Issue:** Opening the output file with mode `'x'` (exclusive creation) works in Python 3, but combined with `SeqIO.write`, if the logic fails *after* opening or if `result.features` contains invalid objects (e.g., from a failed circular coordinate fix), the write might fail mid-stream. More critically, if `args.output` is not provided, it defaults to `input.stem + '_autoannotated.gb'`. If this path already exists due to a previous run that crashed *before* the file open but left a partial temp file (unlikely with 'x', but possible if logic differs), or if the user provides an existing filename expecting overwrite behavior, this will crash.
*   **Reproduction:**
    ```bash
    # Running script twice without cleaning up
    python annotate.py plasmid.fasta --output output.gb --include-unknown-orfs
    # If run again immediately, 'x' mode throws FileNotFoundError or PermissionError
    ```
*   **Assumption:** The user will always ensure the output file does not exist.
*   **Fix:** Change to `mode='w'` (write/overwrite) if the intent is to regenerate annotations deterministically, or add a check before opening:
    ```python
    mode = 'x' if Path(output).exists() == False else 'w' # Or just 'w' for idempotent scripts
    with output.open(mode, encoding='utf-8') as handle: ...
    ```

#### 4. Low Priority: Identity Calculation Precision
*   **Location:** `matching.py` -> `match_features()`
*   **Issue:** `identity = matches / length`. This results in floating-point division. When comparing `identity < minimum_identity`, floating point epsilon errors could theoretically cause a 95.0% match to fail a `< 0.95` check if represented slightly differently, though unlikely with standard floats. However, the logic `if identity == 1` for "exact" vs "variant" is brittle against minor float noise.
*   **Fix:** Use an epsilon tolerance or integer comparison (`matches * 10000 // length >= threshold`) for stability.

#### Recommended Fixes Summary
1.  **Refactor Coordinate Normalization:** Ensure all detected ORFs and matched features are converted to `(start, end)` tuples within `[0, n)` immediately after detection, handling circular wrap-arounds explicitly before creating `SimpleLocation` objects.
2.  **Repair Overlap Detection:** Replace the naive `set().issubset()` logic with a rigorous interval intersection check that respects strand polarity (i.e., two features can only conflict if they occupy the same physical bases on the *same* face of the double helix or explicitly compete for the region).
3.  **Stabilize Export:** Switch file open mode to `'w'` to prevent crashes on repeated runs, assuming deterministic output is desired. Add a `try...except BlockIOError` around the write just in case disk space fails.
4.  **Integer Arithmetic:** Refactor identity checks to use integer math (`matches * 100 >= length * threshold`) to avoid floating-point comparison pitfalls.